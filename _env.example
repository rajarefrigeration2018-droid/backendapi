# ---------- App ----------
APP_NAME=Mistrio API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# ---------- Database ----------
# Supabase > Project Settings > Database > Connection string > URI
# Use the pooler URI (port 6543) on Railway.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---------- Supabase Storage ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=mistrio

# ---------- JWT ----------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ADMIN_TOKEN_EXPIRE_MINUTES=720

# ---------- Auth provider ----------
# firebase = Firebase Phone Auth (production)
# otp      = backend OTP (local testing only)
AUTH_PROVIDER=firebase

# ---------- Firebase ----------
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the ENTIRE downloaded JSON here as ONE single line.
# The same service account is used for both Phone Auth verification and FCM push.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mistrio-xxxx",...}
FIREBASE_PROJECT_ID=mistrio-xxxx

# ---------- OTP fallback (testing only) ----------
OTP_PROVIDER=mock
# Leave EMPTY in production. Set to 123456 to enable the fallback OTP path.
OTP_MASTER_CODE=

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google Maps ----------
GOOGLE_MAPS_API_KEY=

# ---------- CORS ----------
# Use * during development. Lock to real domains before launch.
CORS_ORIGINS=*
